{
  "name": "@nascencestudio/medialibrary",
  "version": "0.1.0",
  "private": true,
  "description": "A media library for StudioCMS: upload, browse and reuse images, video, audio, documents and remote videos",
  "license": "MIT",
  "author": "Nascence Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nascencestudio/medialibrary.git"
  },
  "homepage": "https://github.com/nascencestudio/medialibrary#readme",
  "bugs": {
    "url": "https://github.com/nascencestudio/medialibrary/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/runtime/server.d.ts",
      "default": "./dist/runtime/server.js"
    },
    "./picker": {
      "types": "./dist/ui/picker.d.ts",
      "default": "./dist/ui/picker.js"
    },
    "./Media.astro": "./dist/runtime/Media.astro",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "studiocms": "^0.6.0"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "kysely": "0.29.6",
    "preact": "10.29.8",
    "sharp": "0.35.5",
    "ultrahtml": "1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "astro": "7.3.5",
    "studiocms": "0.6.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "astro",
    "studiocms",
    "studiocms-plugin",
    "media-library",
    "uploads",
    "images"
  ],
  "packageManager": "pnpm@12.4.2"
}
